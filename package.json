{
    "name": "@akms/mcp",
    "version": "0.3.0",
    "description": "Interactive launcher for configuring installed AKMS database, SSH, WSL and S3 MCP runtimes.",
    "keywords": [
        "mcp",
        "model-context-protocol",
        "cli",
        "setup",
        "akms"
    ],
    "license": "MIT",
    "type": "module",
    "bin": {
        "akms-mcp": "lib/cli.js"
    },
    "engines": {
        "node": ">=22"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "prepublishOnly": "node scripts/release-guard.mjs",
        "build": "tsc --noEmit && tsup",
        "dev": "tsx src/cli.ts",
        "start": "node lib/cli.js",
        "pretest": "npm run build",
        "test": "vitest run",
        "prepack": "npm run build"
    },
    "devDependencies": {
        "@types/node": "^24.19.0",
        "tsup": "^8.5.1",
        "tsx": "^4.23.15",
        "typescript": "^5.9.3",
        "vitest": "^4.1.11"
    },
    "dependencies": {
        "smol-toml": "1.9.1"
    }
}
